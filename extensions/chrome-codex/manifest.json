{
  "manifest_version": 3,
  "name": "Codex for Chrome",
  "version": "0.1.0",
  "description": "Codex CLI integration with native messaging for deep research and browser control.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Codex"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": ["nativeMessaging", "scripting", "activeTab", "storage", "tabs"],
  "optional_permissions": ["webRequest", "debugger"],
  "optional_host_permissions": [
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.note.com/*",
    "*://*.qiita.com/*",
    "*://*.zenn.dev/*",
    "*://*.amazon.com/*",
    "*://*.amazon.co.jp/*",
    "*://*.mercari.com/*",
    "*://*.mercari.jp/*",
    "*://auctions.yahoo.co.jp/*"
  ]
}
