[workspace.package]
edition = "2021"
version = "2.3.0"
rust-version = "1.80"

[workspace]
members = [
    "core",
    "deep-research",
    "mcp-types",
    "protocol",
    "cli",
]
resolver = "2"

[workspace.lints.rust]
unsafe_code = "forbid"
unreachable_pub = "warn"
unused_qualifications = "warn"
unreachable = "warn"
panic = "warn"
missing_docs = "warn"

[workspace.dependencies]
aes-gcm = "0.10"
askama = "0.12"
async-stream = "0.3"
clap = "4.5"
codex-core = { path = "core" }
clap_complete = "4.5"
codex-ansi-escape = { path = "ansi-escape" }
codex-app-server = { path = "app-server" }
anyhow = "1.0"
async-channel = "2.3"
async-trait = "0.1"
base64 = "0.22"
bytes = "1.7"
chrono = { version = "0.4", features = ["serde"] }
color-eyre = "0.6"
crossterm = "0.27"
derive_more = "0.99"
diffy = "0.3"
dirs = "5.0"
dunce = "1.0"
ed25519-dalek = "2.0"
futures = "0.3"
dashmap = { version = "5.5", features = ["serde"] }
env-flags = "0.1"
eventsource-stream = "0.2"
hkdf = "0.12"
hmac = "0.12"
keyring = { version = "2.0", features = ["apple-native", "windows-native", "linux-native"] }
once_cell = "1.19"
os_info = "3.0"
reqwest = { version = "0.11", features = ["json", "stream"] }
sha1 = "0.10"
sha2 = "0.10"
similar = "2.5"
time = { version = "0.3", features = ["formatting", "parsing"] }
# Remove duplicate time entry
tokio = { version = "1.0", features = ["full"] }
tokio-util = { version = "0.7", features = ["rt"] }
toml = "0.8"
toml_edit = "0.22"
tracing = { version = "0.1", features = ["log"] }
tree-sitter = "0.23"
tree-sitter-bash = "0.23"
url = "2.5"
uuid = { version = "1.0", features = ["serde", "v4", "v5"] }
which = "6.0"
wildmatch = "2.3"
landlock = "0.3"
seccompiler = "0.4"
openssl-sys = { version = "0.9", features = ["vendored"] }
rustls = "0.21"
rustls-pemfile = "1.0"
tokio-rustls = "0.24"
x509-parser = "0.15"
# Test dependencies
assert_cmd = "2.0"
assert_matches = "1.5"
core_test_support = { path = "core-test-support" }
escargot = "0.5"
maplit = "1.0"
predicates = "3.0"
pretty_assertions = "1.4"
serial_test = "2.0"
tokio-test = "0.4"
tracing-test = { version = "0.2", features = ["no-env-filter"] }
walkdir = "2.5"
wiremock = "0.5"
# Additional crates
codex-app-server-protocol = { path = "app-server-protocol" }
codex-apply-patch = { path = "apply-patch" }
codex-keyring-store = { path = "keyring-store" }
codex-async-utils = { path = "async-utils" }
codex-deep-research = { path = "deep-research" }
codex-file-search = { path = "file-search" }
codex-git = { path = "git" }
codex-otel = { path = "otel" }
codex-protocol = { path = "protocol" }
codex-rmcp-client = { path = "rmcp-client" }
codex-utils-pty = { path = "utils-pty" }
codex-utils-readiness = { path = "utils-readiness" }
codex-utils-string = { path = "utils-string" }
codex-utils-tokenizer = { path = "utils-tokenizer" }
git2 = "0.18"
hex = "0.4"
http = "1.1"
image = "0.25"
indexmap = "2.5"
itertools = "0.12"
lazy_static = "1.5"
libc = "0.2"
mcp-types = "0.1"
opentelemetry-appender-tracing = "0.4"
pathdiff = "0.2"
pulldown-cmark = "0.10"
rand = "0.8"
ratatui = "0.26"
regex = "1.10"
regex-lite = "0.1"
serde = "1.0"
serde_json = "1.0"
serde_yaml = "0.9"
shlex = "1.3"
statrs = "0.16"
strum = "0.26"
strum_macros = "0.26"
supports-color = "3.0"
tempfile = "3.12"
test-log = "0.2"
thiserror = "1.0"
tokio-stream = "0.1"
futures-util = "0.3"
# tracing duplicates removed
tracing-subscriber = "0.3"
tree-sitter = "0.23"
tree-sitter-bash = "0.23"
tree-sitter-highlight = "0.1"
unicode-segmentation = "1.11"
unicode-width = "0.1"
url = "2.5"
uuid = "1.10"
which = "6.0"
wildmatch = "2.3"
codex-windows-sandbox = { path = "windows-sandbox" }
arboard = "3.4"
# Additional dependencies for TUI and QC
codex-app-server-protocol = { path = "protocol" }
codex-apply-patch = { path = "apply-patch" }
codex-keyring-store = { path = "keyring-store" }
codex-async-utils = { path = "async-utils" }
codex-deep-research = { path = "deep-research" }
codex-file-search = { path = "file-search" }
codex-git = { path = "git" }
codex-otel = { path = "otel" }
codex-protocol = { path = "protocol" }
codex-rmcp-client = { path = "rmcp-client" }
codex-utils-pty = { path = "utils-pty" }
codex-utils-readiness = { path = "utils-readiness" }
codex-utils-string = { path = "utils-string" }
codex-utils-tokenizer = { path = "utils-tokenizer" }
