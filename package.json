{
  "name": "@zapabob/codex",
  "version": "2.3.0",
  "type": "module",
  "description": "AI-Native OS with 4D Git Visualization & VR/AR Support - The world's first AI operating system with kernel integration",
  "keywords": [
    "ai",
    "coding-assistant",
    "llm",
    "git-visualization",
    "vr",
    "ar",
    "quest",
    "vision-pro",
    "cuda",
    "kernel",
    "sub-agents",
    "mcp",
    "deep-research"
  ],
  "main": "index.js",
  "bin": {
    "codex": "./bin/codex.js"
  },
  "scripts": {
    "postinstall": "node scripts/install-binary.js",
    "prepublishOnly": "npm run build:binary",
    "build:binary": "node scripts/build-binary.js",
    "build:binary:fast": "node scripts/build-binary.js --skip-clean",
    "build": "npm run build:binary",
    "build:fast": "npm run build:binary:fast",
    "build-and-install": "node scripts/build-and-install.js",
    "build-and-install:fast": "node scripts/build-and-install.js --skip-clean",
    "test": "echo \"Error: no test specified\" && exit 1",
    "implementation-log": "node scripts/create-implementation-log.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zapabob/codex.git"
  },
  "author": "zapabob <zapabob@github.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/zapabob/codex/issues"
  },
  "homepage": "https://github.com/zapabob/codex#readme",
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "bin/",
    "scripts/",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {},
  "devDependencies": {}
}
