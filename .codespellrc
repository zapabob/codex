[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
skip = .git*,vendor,*-lock.yaml,package-lock*.json,*.lock,.codespellrc,.codespellignore,*test.ts,*.jsonl,frame*.txt,node_modules,*.log,*.txt,_docs,.specstory,.archive,package-lock.json.bak,docs/zapabob/*,./docs/zapabob/*
check-hidden = true
ignore-regex = ^\s*"image/\S+": ".*|\b(afterAll)\b
ignore-words-list = ratatui,ser,LOD,lod,strat,Aspectos,erros,Probleme,Sie
