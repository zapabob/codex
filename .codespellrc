[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
skip = .git*,vendor,*-lock.yaml,*.lock,.codespellrc,*test.ts,*.jsonl,frame*.txt,*.snap,*.snap.new,*meriyah.umd.min.js,.specstory/history/*,logs/*,archive/*,*package-lock.json,*yarn.lock,*pnpm-lock.yaml,codex-gui-x/package-lock.json,*/playwright-report/*,*/test-results/*,*/dist/*,*/build/*,*/.next/*
check-hidden = true
ignore-regex = ^\s*"image/\S+": ".*|\b(afterAll)\b
ignore-words-list = ratatui,ser,iTerm,iterm2,iterm,te,TE,LOD,Coo,vEw
